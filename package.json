{
  "name": "devkit",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Developer productivity CLI with nightly automated commits",
  "license": "MIT",
  "author": "Deniz Alban",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buzludeniz/devkit.git"
  },
  "homepage": "https://github.com/buzludeniz/devkit#readme",
  "bugs": {
    "url": "https://github.com/buzludeniz/devkit/issues"
  },
  "scripts": {
    "dev": "pnpm --filter @devkit/cli dev",
    "build": "pnpm --filter @devkit/core build && pnpm --filter @devkit/cli build",
    "lint": "pnpm --filter @devkit/core lint && pnpm --filter @devkit/cli lint",
    "test": "pnpm --filter @devkit/core test && pnpm --filter @devkit/cli test && vitest run",
    "typecheck": "pnpm --filter @devkit/core typecheck && pnpm --filter @devkit/cli typecheck && tsc -p scripts/tsconfig.json",
    "nightly:maintenance": "tsx scripts/run-nightly.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "publishConfig": {
    "access": "public"
  }
}
