{
  "name": "@devkit/cli",
  "version": "0.1.0",
  "description": "CLI entry point for devkit",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "devkit": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "lint": "biome check src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@devkit/core": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@biomejs/biome": "^1.9.4",
    "tsx": "^4.19.2",
    "@types/node": "^22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buzludeniz/devkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/buzludeniz/devkit#readme",
  "bugs": {
    "url": "https://github.com/buzludeniz/devkit/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
