{
  "name": "@buzludeniz/devkit-cli",
  "version": "0.1.0",
  "description": "CLI entry point for devkit",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "devkit": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "lint": "biome check src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@buzludeniz/devkit-core": "workspace:*",
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@biomejs/biome": "^2.6.6",
    "tsx": "^4.19.2",
    "@types/node": "^22.20.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buzludeniz/devkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/buzludeniz/devkit#readme",
  "bugs": {
    "url": "https://github.com/buzludeniz/devkit/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
