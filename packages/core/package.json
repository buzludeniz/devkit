{
  "name": "@buzludeniz/devkit-core",
  "version": "0.1.0",
  "description": "Core utilities and shared types for devkit",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "lint": "biome check src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buzludeniz/devkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/buzludeniz/devkit#readme",
  "bugs": {
    "url": "https://github.com/buzludeniz/devkit/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
